<Window x:Class="ParentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent Application" Height="350" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Number 1:" Margin="0,5" FontSize="14" />
            <TextBox Name="Number1TextBox" Margin="0,5" Height="30" />

            <TextBlock Text="Number 2:" Margin="0,5" FontSize="14" />
            <TextBox Name="Number2TextBox" Margin="0,5" Height="30" />

            <TextBlock Text="Operation (+, -, *, /):" Margin="0,5" FontSize="14" />
            <TextBox Name="OperationTextBox" Margin="0,5" Height="30" />

            <Button Content="Calculate and Show in Notepad" Margin="0,15" Height="40" Click="StartChildProcess" />
        </StackPanel>
    </Grid>
</Window>